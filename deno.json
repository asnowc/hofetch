{
  "name": "@asla/hofetch",
  "version": "0.0.2",
  "exports": "./src/mod.ts",
  "tasks": {
    "test": "deno x vitest run",
    "check-type": "deno check src test",
    "check-fmt": "deno fmt --check src test",
    "fmt": "deno fmt src test"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.window", "es2020"]
  },
  "fmt": {
    "lineWidth": 120
  },
  "license": "MIT",
  "publish": {
    "include": ["README.md", "src/**"]
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.2",
    "vitest": "npm:vitest@^4.1.6"
  }
}
